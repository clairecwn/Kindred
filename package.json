{
  "name": "kindred",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test frontend/src/lib/analysis/__tests__/*.test.js frontend/src/ventures/__tests__/*.test.js frontend/src/grove/story/__tests__/*.test.js frontend/src/grove/player/__tests__/*.test.js frontend/src/grove/interiors/__tests__/*.test.js frontend/src/kingdom/__tests__/*.test.js",
    "test:analysis": "node --test frontend/src/lib/analysis/__tests__/*.test.js",
    "eval:journal-models": "node --env-file=.env tools/scripts/compare-journal-models.mjs",
    "test:ventures": "node --test frontend/src/ventures/__tests__/*.test.js",
    "test:avatar": "node --test frontend/src/avatar/kindredSelfTest.mjs",
    "check": "npm run test && npm run test:avatar && vite build --outDir ../dist_check --emptyOutDir",
    "build:avatars": "echo 'Characters are authored in assets/characters/kindred_character_01.blend and exported to frontend/public/models/ from Blender'",
    "db:start": "supabase start --workdir backend",
    "db:stop": "supabase stop --workdir backend",
    "db:push": "supabase db push --workdir backend",
    "functions:deploy": "supabase functions deploy --workdir backend"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "@vitejs/plugin-react": "^5.0.0",
    "framer-motion": "^12.39.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "vite": "^6.0.1"
  },
  "devDependencies": {
    "supabase": "^2.113.0"
  }
}
