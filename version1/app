          boxShadow:"0 0 0 5px rgba(91,156,246,0.25)" }}/>
        <div style={{ position:"absolute",bottom:8,right:10,fontSize:10,color:"#718096",fontWeight:600,
          background:"rgba(255,255,255,0.85)",borderRadius:6,padding:"2px 7px" }}>📍 Singapore</div>
      </div>

      <div style={{ background:"linear-gradient(135deg,#EEF2FF,#E0E7FF)",borderRadius:12,
        padding:"10px 14px",marginBottom:12,display:"flex",gap:10,alignItems:"center" }}>
