        </div>
        <div style={{display:"flex",gap:8,marginBottom:12}}>
          <button style={{...btn, flex:1}} onClick={() => { setEmotion(detected.emotion); setCurrency(c=>c+50); setDone(true); setStep("result"); }}>
            Yes, that's it
          </button>
          <button style={{...btnOutline, flex:1}} onClick={() => setStep("text")}>
            Not quite
          </button>
        </div>
        <div style={{color:"#A0AEC0",fontSize:12,textAlign:"center"}}>or choose an emotion below:</div>
        <div style={{display:"flex",flexWrap:"wrap",gap:4,marginTop:8}}>
          {Object.entries(EM).map(([k,v]) => (
            <button key={k} onClick={() => { setEmotion(k); setDetected({...detected,emotion:k}); setCurrency(c=>c+50); setDone(true); setStep("result"); }}
              style={{ background: detected.emotion===k ? `${v.c}33` : "white", border:`2px solid ${detected.emotion===k?v.c:"#EDF2F7"}`,
                borderRadius:50, padding:"4px 10px", fontSize:11, fontWeight:700, cursor:"pointer",
                fontFamily:"'Nunito',sans-serif", color:"#2D3748", transition:"all .15s" }}>
              {v.e}
            </button>
          ))}
        </div>
      </div>
    );
  }

  if (step === "result" && detected) {
    const de = EM[detected.emotion]||EM.neutral;
    return (
      <div style={anim}>
        <div style={{textAlign:"center",marginBottom:16}}>
