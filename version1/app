          ))}
        </div>
        <button style={{...btnOutline, width:"100%"}} onClick={reset}>Done</button>
      </div>
    );
  }

  return (
    <div style={{paddingBottom:20}}>
      <div style={{marginBottom:14}}>
        <div style={{...h1,fontFamily:"'Fredoka One',cursive",fontSize:24}}>Good morning! ☀️</div>
