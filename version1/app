      </button>
    </div>
  );

  if (step === "loading") return (
    <div style={{...anim, display:"flex",flexDirection:"column",alignItems:"center",justifyContent:"center",height:380,gap:16}}>
      <div style={{fontSize:52,animation:"pulse 1.5s infinite"}}>🔮</div>
