        </div>
      </div>

      <div style={{...row("space-between"),marginBottom:10}}>
        <span style={h3}>📍 Activities Near You</span>
        <button style={{ background:"linear-gradient(135deg,#5B9CF6,#7B6CF6)",border:"none",borderRadius:20,
          padding:"5px 12px",fontSize:11,fontWeight:800,color:"white",cursor:"pointer",
          fontFamily:"'Nunito',sans-serif" }}>+ Drop Pin</button>
      </div>

      {ACTS.map((a,i) => (
        <div key={i} style={{...card,marginBottom:8,cursor:"pointer",transition:"transform .15s"}}
          onClick={() => setSelected(a)}
          onMouseOver={e => e.currentTarget.style.transform="translateY(-1px)"}
          onMouseOut={e => e.currentTarget.style.transform="translateY(0)"}>
          <div style={{display:"flex",gap:12,alignItems:"flex-start"}}>
            <div style={{ width:44,height:44,flexShrink:0,background:"linear-gradient(135deg,#EEF2FF,#E0E7FF)",
              borderRadius:14,display:"flex",alignItems:"center",justifyContent:"center",fontSize:22 }}>
              {a.icon}
            </div>
            <div style={{flex:1,minWidth:0}}>
              <div style={{fontWeight:800,fontSize:14,color:"#2D3748",marginBottom:2}}>{a.t}</div>
              <div style={{fontSize:11,color:"#A0AEC0",marginBottom:3}}>📅 {a.date}</div>
              <div style={{fontSize:11,color:"#718096",marginBottom:6}}>📍 {a.loc}</div>
              <div style={{background:"#F0F4FF",borderRadius:4,height:5,overflow:"hidden"}}>
                <div style={{ width:`${(a.joined/a.max)*100}%`,background:"linear-gradient(90deg,#5B9CF6,#7B6CF6)",
                  height:"100%",borderRadius:4 }}/>
              </div>
              <div style={{fontSize:10,color:"#A0AEC0",marginTop:3}}>{a.joined}/{a.max} joined</div>
            </div>
            {joined.includes(a.id)
              ? <span style={{fontSize:18,color:"#48BB78"}}>✅</span>
              : <div style={{ background:"linear-gradient(135deg,#5B9CF6,#7B6CF6)",borderRadius:20,
                  padding:"5px 12px",fontSize:11,fontWeight:800,color:"white",flexShrink:0 }}>View →</div>}
          </div>
        </div>
      ))}
    </div>
  );
}

