          onFocus={e => e.target.style.borderColor="#5B9CF6"}
          onBlur={e => e.target.style.borderColor="#E2E8F0"}/>
        <div style={{fontSize:11,color:"#A0AEC0",marginTop:6}}>🔒 Entirely private — only you can see this</div>
      </div>
      <button style={{...btn, width:"100%", opacity: freeText.trim() ? 1 : 0.4}} onClick={submit}>
