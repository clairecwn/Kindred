function WellnessTab({ emotion, setEmotion, currency, setCurrency, streak, setStreak }) {
  const [step, setStep] = useState("idle");
  const [qIdx, setQIdx] = useState(0);
  const [answers, setAnswers] = useState({});
  const [freeText, setFreeText] = useState("");
  const [detected, setDetected] = useState(null);
  const [done, setDone] = useState(false);
  const [journalMode, setJournalMode] = useState(false);
  const [jText, setJText] = useState("");
  const [entries, setEntries] = useState([
    { date:"May 9",    text:"Today was wonderful — walked in the sunshine. Small moments of joy.",  em:"happy"   },
    { date:"May 8",    text:"Felt overwhelmed but finished the project. Proud of how I pushed through.", em:"content" },
  ]);
  const e = EM[emotion]||EM.neutral;

  async function submit() {
    if (!freeText.trim()) return;
    setStep("loading");
    try {
      const r = await fetch("https://api.anthropic.com/v1/messages", {
        method:"POST", headers:{"Content-Type":"application/json"},
        body: JSON.stringify({
          model:"claude-sonnet-4-20250514", max_tokens:250,
          messages:[{ role:"user", content:`Analyze this wellness reflection deeply. Respond ONLY with JSON object, no markdown. Fields: "emotion" (one from: happy excited calm anxious sad tired angry content grateful hopeful overwhelmed neutral), "certainty" (0-100), "clarificationQ" (optional gentle question max 15 words), "insight" (1-2 word theme). Text: "${freeText}"` }]
        })
      });
      const d = await r.json();
      const p = JSON.parse(d.content[0].text.trim());
      if (p.clarificationQ && p.certainty < 85) {
        setDetected({...p, stage:"clarify"}); setStep("clarify");
      } else {
        setDetected({...p, stage:"result"}); setEmotion(p.emotion);
        setCurrency(c => c + 50); setDone(true); setStep("result");
      }
    } catch {
      setDetected({ emotion:"neutral", reason:"Noted with care", stage:"result" });
      setStep("result"); setDone(true);
    }
  }

  function answer(v) {
    const na = { ...answers, [QS[qIdx].id]: v };
    setAnswers(na);
    if (qIdx < QS.length - 1) setQIdx(q => q + 1);
    else setStep("text");
  }

  function reset() { setStep("idle"); setQIdx(0); setAnswers({}); setFreeText(""); setDetected(null); }

  function saveJournal() {
    if (!jText.trim()) return;
    setEntries(prev => [{ date:"Today", text:jText, em:emotion }, ...prev]);
    setJText(""); setJournalMode(false);
  }

  if (journalMode) return (
    <div style={anim}>
      <div style={row("flex-start")} onClick={() => setJournalMode(false)}>
        <span style={{cursor:"pointer",fontSize:"20px",marginRight:8}}>←</span>
        <span style={h2}>📔 Journal Entry</span>
      </div>
      <div style={{...card, marginTop:12}}>
        <div style={label}>TODAY, MAY 10</div>
        <textarea value={jText} onChange={e => setJText(e.target.value)} autoFocus
          placeholder="Let your thoughts flow freely... no judgment here 🌿"
          style={{ width:"100%", minHeight:180, border:"none", outline:"none", fontSize:14, fontFamily:"'Nunito',sans-serif",
            lineHeight:1.7, color:"#2D3748", resize:"none", background:"transparent" }}/>
      </div>
      <div style={{ background:"#E8F5E9", borderRadius:12, padding:"10px 14px", margin:"12px 0",
        fontSize:12, color:"#388E3C", fontWeight:600, lineHeight:1.5 }}>
        💡 After a month of entries, your AI companion will share personalised observations subtly through the game — no advice, just warm observations like "You tend to feel better on sunny days!"
      </div>
      <button style={{...btn, width:"100%", opacity: jText.trim() ? 1 : 0.4}} onClick={saveJournal}>Save Entry</button>
    </div>
  );

  if (step === "questions") {
    const q = QS[qIdx];
    return (
      <div style={anim}>
        <div style={row("flex-start")}>
          <span style={{cursor:"pointer",fontSize:"20px",marginRight:8}} onClick={reset}>←</span>
          <span style={h2}>Morning Check-In</span>
        </div>
        <div style={{display:"flex",gap:5,margin:"12px 0 18px"}}>
          {QS.map((_,i) => <div key={i} style={{flex:1,height:4,borderRadius:4,background: i<=qIdx?"#5B9CF6":"#E2E8F0",transition:"background .3s"}}/>)}
        </div>
        <div style={{...card, textAlign:"center"}}>
          <div style={{fontSize:32,marginBottom:8}}>{q.icon}</div>
          <div style={{...h2, marginBottom:16}}>{q.q}</div>
          {q.opts.map((o,i) => (
            <button key={i} onClick={() => answer(i)} style={{ width:"100%", background:"white", border:"2px solid #EDF2F7",
              borderRadius:12, padding:"10px 14px", fontSize:13, fontWeight:700, fontFamily:"'Nunito',sans-serif",
              cursor:"pointer", textAlign:"left", marginBottom:7, color:"#2D3748", transition:"all .15s" }}
              onMouseOver={e => { e.currentTarget.style.borderColor="#5B9CF6"; e.currentTarget.style.background="#F0F5FF"; }}
              onMouseOut={e => { e.currentTarget.style.borderColor="#EDF2F7"; e.currentTarget.style.background="white"; }}>
              {o}
            </button>
          ))}
        </div>
        <div style={{textAlign:"center",color:"#A0AEC0",fontSize:12,marginTop:10}}>{qIdx+1} of {QS.length}</div>
      </div>
    );
  }

  if (step === "text") return (
    <div style={anim}>
      <div style={row("flex-start")}>
        <span style={{cursor:"pointer",fontSize:"20px",marginRight:8}} onClick={() => setStep("questions")}>←</span>
        <span style={h2}>One last thing…</span>
      </div>
      <div style={{...card, marginTop:12, marginBottom:12}}>
        <div style={{fontSize:26,textAlign:"center",marginBottom:8}}>💬</div>
        <div style={{...h3, textAlign:"center",marginBottom:12}}>How are you feeling in your own words?</div>
        <textarea value={freeText} onChange={e => setFreeText(e.target.value)}
          placeholder='E.g. "I'm feeling a bit wonky but hopeful…"'
          style={{ width:"100%", minHeight:100, border:"2px solid #E2E8F0", borderRadius:12,
            padding:12, fontSize:14, fontFamily:"'Nunito',sans-serif", resize:"none", outline:"none",
