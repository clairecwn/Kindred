            borderRadius:50,padding:"5px 14px",marginBottom:6 }}>
            <span style={{fontSize:20}}>{de.e}</span>
            <span style={{fontWeight:800,fontSize:16,color:"#2D3748"}}>{de.l}</span>
          </div>
          <div style={{color:"#718096",fontSize:13,marginBottom:4}}>{detected.reason}</div>
          <div style={{color:"#A0AEC0",fontSize:11}}>Your avatar has been updated ✨</div>
