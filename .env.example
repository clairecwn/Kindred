# ── Google Gemini (powers the conversational AI companion in the journal)
# Free tier: 1,500 requests/day, no credit card needed.
# Get your key at: https://aistudio.google.com  → Get API Key
# Works directly from the browser — no proxy needed.
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ── Supabase (free PostgreSQL — enables cross-device save & real-time multiplayer)
# Create a free project at https://supabase.com, then paste your project URL and anon key.
# Without these the app falls back to browser IndexedDB (works offline, single device).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── HuggingFace (free emotion AI — improves journal emotion detection quality)
# Create a free account at https://huggingface.co and generate a read-only token.
# Without this key the app still works — it uses the public inference endpoint (rate-limited).
VITE_HF_API_KEY=hf_your_token_here
