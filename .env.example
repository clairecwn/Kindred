# Copy this file to `.env` and fill in your key, then RESTART the dev server —
# Vite only reads .env at startup, so edits mid-session have no effect.

# ── Groq — ACTIVE.
# Powers the journal companion, check-in reactions and emotion reading.
# Free tier, no credit card needed. Get a key at: https://console.groq.com/keys
# Without this key companion responses are unavailable; local mood analysis still works.
#
# NOTE: anything prefixed VITE_ is bundled into the client JavaScript and is
# therefore visible to anyone who opens the deployed site. That is fine for
# local development, but before deploying publicly move these calls behind a
# small server-side proxy so the key is never shipped to the browser.
VITE_GROQ_API_KEY=your-groq-api-key-here
# Optional override. The default is openai/gpt-oss-120b.
VITE_GROQ_MODEL=
# Optional backup Groq model, used only when the primary request fails.
# Defaults to the production openai/gpt-oss-20b model.
VITE_GROQ_FALLBACK_MODEL=
# Last-resort Groq route defaults to qwen/qwen3.8-27b.
VITE_GROQ_LAST_RESORT_MODEL=
# Assessment defaults to the smaller openai/gpt-oss-20b model so writing does
# not consume the same primary route's capacity. Its fallback is 120b.
VITE_GROQ_ASSESSOR_MODEL=
VITE_GROQ_ASSESSOR_FALLBACK_MODEL=
# Optional Gemini backup. Setting this key sends journal context to Gemini if
# Groq is unavailable. Leave blank until you have compared providers.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# ── Supabase — ACTIVE.
# Enables accounts and cross-device save. Leave both blank to skip sign-in
# entirely; saves then go to browser IndexedDB (offline, single device) via
# hooks/useDatabaseState.js.
#
# Copy both values from your project's API settings:
#   https://supabase.com/dashboard/project/_/settings/api
# The URL must be the ref of a project that still exists — a deleted, paused or
# mistyped ref makes sign-in fail with a bare "Failed to fetch", because the
# hostname never resolves.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Ventures activity supply.
# OpenStreetMap Overpass needs no key and works out of the box.
# data.gov.sg is optional: paste the dataset URLs you want to pull from.
# Without these, Singapore-specific supply is inert and Overpass covers the map.
VITE_DATAGOVSG_SPORTSG_URL=
VITE_DATAGOVSG_COMMUNITY_CLUBS_URL=
